# ─────────────────────────────────────────────────────────────────────────────
# CoffeeChat AI — environment variables
# Copy to .env.local for local development. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# --- Data backend -------------------------------------------------------------
# "local"    = JSON file in .data/ (no accounts needed; development only)
# "supabase" = Supabase Postgres + Auth (production)
# If unset: "supabase" when the two Supabase vars below are set, else "local".
DATA_BACKEND=local

# --- Local mode ---------------------------------------------------------------
# Passcode for the local sign-in screen. Strongly recommended.
LOCAL_PASSCODE=
# Signs the local session cookie. 32+ random characters (openssl rand -hex 32).
SESSION_SECRET=

# --- Supabase (production) ----------------------------------------------------
# From Supabase → Project Settings → API. The publishable (anon) key is safe to
# expose to browsers; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated emails allowed to sign in. Required in production.
ALLOWED_EMAILS=

# Public URL of the site (used for magic-link redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI -----------------------------------------------------------------------
# Server-side only. Without a key the app uses offline demo templates.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# auto | anthropic | mock
AI_PROVIDER=auto
# Max real AI requests per user per day.
AI_DAILY_LIMIT=60

# --- Public demo --------------------------------------------------------------
DEMO_ENABLED=true
# "mock" (default, free, no key used) or "live" (uses your Anthropic key!)
DEMO_AI=mock
DEMO_AI_DAILY_LIMIT=15
